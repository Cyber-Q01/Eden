{
  "expo": {
    "name": "EdenHome",
    "slug": "eden-home",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/EdenIcon.png",
    "scheme": "edenhome",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/EdenIcon.png",
        "backgroundImage": "./assets/images/EdenIcon.png",
        "monochromeImage": "./assets/images/EdenIcon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.edenhome.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/EdenIcon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/EdenIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd114a43-c353-4b47-9d22-29ad247b8623"
      }
    },
    "owner": "israelite125"
  }
}